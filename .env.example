# PostgreSQL local o Neon. Nunca compartir credenciales reales.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketera?schema=public"
# Conexión directa para migraciones (en Neon, sin -pooler).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ticketera?schema=public"
APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="America/Argentina/Buenos_Aires"
# Se utilizarán en las próximas fases. Mantener fuera de NEXT_PUBLIC_*.
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# ID de la cuenta vendedora; modo explícito test o live. APP_URL debe ser HTTPS público.
MERCADOPAGO_COLLECTOR_ID=""
MERCADOPAGO_MODE="test"
# Secreto aleatorio de al menos 32 caracteres para /api/payments/reconcile.
CRON_SECRET=""
RESEND_API_KEY=""
# Email simple del dominio verificado, por ejemplo entradas@tu-dominio.com.
EMAIL_FROM=""
# 32 bytes aleatorios en hexadecimal (64 caracteres). Crear con pnpm tickets:setup.
# Respaldar: cambiarla sin migrar el cifrado impide recuperar enlaces existentes.
TICKET_ENCRYPTION_KEY=""
# Sólo desarrollo local con compose.yaml; usar clave aleatoria, nunca esta muestra.
POSTGRES_PASSWORD=""
# Sólo pruebas automatizadas: base separada, nunca datos productivos.
TEST_DATABASE_URL=""
